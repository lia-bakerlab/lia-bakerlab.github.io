---
import { navigation } from '../data/site';
import { logos } from '../data/site';
---

<header class="site-header">

    <div class="grid grid-cols-2 header-inner">
      <a
        href="#inicio"
        aria-label="La Castellana - Inicio"
      >
      <img src={logos.GO} alt="" style="width: 70%;">
    </a>
      <nav
        class="navigation"
        aria-label="Navegación principal"
        style="padding: 2%"
      >
        {
          navigation.map((item)=> (
            <a href={item.href}>
            {item.label}
            </a>
          ))
        }

        <a
              href="#contacto"
              class="button button-secondary"
            >
              Cotiza Aquí
        </a>

      </nav>

    </div>

  </header>