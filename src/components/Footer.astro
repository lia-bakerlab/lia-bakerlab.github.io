---
import { site } from '../data/site';
import { logos } from '../data/site';

const year = new Date().getFullYear();
---
<footer class="bg-navy text-white">
  <div class="container py-16 lg:py-20">

    <div class="grid grid-cols-3 items-center border-b border-white/15 pb-14">

      {
        logos.LogosFooter.map((element) => (
          <div class="flex items-center justify-center ">
            <img
              src={element}
              alt=""
              class="max-h-30 max-w-[120px] w-auto object-contain"
            />
          </div>
        ))
      }

    </div>

    <div
      class="flex flex-col gap-3 pt-8 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between"
    >

      <p>
        Información sujeta a verificación.
      </p>
    </div>

  </div>
</footer>