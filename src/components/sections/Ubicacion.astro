---
import Image from 'astro/components/Image.astro';
import CalleFoto from '../../../public/images/la-castellana/FOTO-BARRIO-ALTA.jpg';
import DeptoFoto from '../../../public/images/la-castellana/detalle-alta.jpg';

---

<section
      id="ubicacion"
      class="w-full h-screen overflow-hidden bg-[#2d2d25] text-left text-[#736a4b]"
    >
      <div class="grid h-full grid-cols-1 md:grid-cols-2">

        
        <Image src={CalleFoto} 
        alt="Imagen alta resolución del departamento en el render del proyecto"
        class="h-full w-full object-cover"
        />

        <div class="flex h-full items-center">
        <div class="m-[10%]">
          <span class="eyebrow">
            Ubicación
          </span>

        <h2
          class="tracking-tight md:tracking-wider leading-[150%] font-rellika text-[60px] font-light"
          style="margin-bottom: 5%;"
        >
            La ubicación <br>
             lo es todo.
          </h2>

          <p>
                Vivir en La Castellana significa estar cerca de 
                todo lo que necesitas. Su ubicación en La 
                Castellana Sur con Apoquindo permite 
                disfrutar de la conectividad, servicios y vida 
                urbana de Las Condes desde un entorno 
                residencial consolidado.
          </p>

        <br>

        <a
              href="#contacto"
              class="button button-secondary"
            >
              Cotiza Aquí
            </a>

        </div>
        </div>

      </div>

    </section>

