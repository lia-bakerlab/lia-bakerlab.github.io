---
import Image from 'astro/components/Image.astro';
import { media } from '../../data/site';
import ubiFoto from '../../../public/images/mapa-GO.jpg'
---
 <section
      id="entorno"
      class="hero-end
    flex
    h-screen
    w-screen
    flex-col
    items-center
    justify-center
    overflow-hidden
    text-white
    "
    style="background-color: black;"
    >
 


    <div class="z-10"
    >

        <div class="flex flex-col items-center justify-center
    overflow-hidden" style="text-align: center;">

          <span class="eyebrow">
            EL ENTORNO
          </span>

          <p class="hero-claim" style="font-family: Rellika;">
            Un barrio consolidado,
            <br>
            en una ubicación estratégica.          
        </p>

          <p class="hero-description">
            La Castellana se inserta en un sector reconocido de Las Condes, 
            con acceso a importantes ejes de transporte, comercio, servicios 
            y equipamiento urbano. Una ubicación pensada para aprovechar 
            mejor la ciudad y hacer más simple cada día.
          </p>

          <div class="hero-actions">

            <a
              href="#contacto"
              class="button button-secondary"
            >
              Cotiza Aquí
            </a>

          </div>

        </div>
      </div>

       <Image 
    src={ubiFoto} 
    id = "hero"
    alt="A descriptive description of the hero image" 
    class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out"
    layout='constrained'
    fetchpriority="high"
    style="
    opacity: 45%;
    "
  />


    </section>