---
/*
|--------------------------------------------------------------------------
| IMÁGENES DEL CAROUSEL
|--------------------------------------------------------------------------
|
| Agrega o elimina elementos de este array.
|
| Los archivos están ubicados dentro de:
| public/carrousel/entorno/
|
| Por eso en el HTML se escriben desde:
| /carrousel/entorno/...
|
*/
import { carrousel } from "../../data/site";

const loopSlides =
  carrousel.length > 1
    ? [
        carrousel[carrousel.length - 1],
        ...carrousel,
        carrousel[0],
      ]
    : carrousel;
---


<section
  id="galeria"
  data-entorno-carousel
  data-count={carrousel.length}
  class="
    w-full
    h-screen
    overflow-hidden
    bg-[#ded9d0]
    py-8
    md:py-10
    lg:py-12
  "
>

  <!-- ==========================================================
       TÍTULO
       ========================================================== -->

  <div
    class="
      mx-auto
      flex
      w-full
      max-w-[1536px]
      items-center
      gap-6
      px-6
      md:gap-8
      md:px-12
      lg:px-16
    "
  >

    <h2
      class="
        shrink-0
        text-[clamp(3rem,4.5vw,5rem)]
        font-light
        leading-none
        tracking-[-0.03em]
        text-[#8e835f]
      "
      style="font-family: rellika, serif;"
    >
      Descubre tu entorno.
    </h2>


    <!-- Línea horizontal -->

    <div
      class="
        mt-4
        hidden
        h-px
        flex-1
        bg-[#99958c]/40
        sm:block
      "
    >
    </div>

  </div>


  <!-- ==========================================================
       CAROUSEL
       ========================================================== -->

  <div
    data-carousel-viewport
    class="
      relative
      mt-12
      w-full
      overflow-hidden
      md:mt-16
    "
  >

    <!--
      El track contiene TODAS las imágenes.

      JavaScript moverá este elemento completo hacia
      izquierda/derecha.
    -->

    <div
      data-carousel-track
      class="
        flex
        items-center
        gap-[4vw]
        will-change-transform
        md:gap-[3vw]
      "
    >

      {
        loopSlides.map((image, index) => (

          <button
                type="button"
                data-slide
                data-index={index}
                aria-label={`Ver imagen ${index + 1}`}
                class="
                    group
                    relative
                    block
                    w-[86vw]
                    shrink-0
                    cursor-pointer
                    overflow-hidden

                    scale-[0.96]
                    opacity-80

                    transition-[transform,opacity]
                    duration-700
                    ease-out

                    md:w-[66vw]
                    md:max-w-[1180px]
                "
                >

            <!--
              Mobile:
              imagen más vertical

              Desktop:
              proporción muy panorámica,
              parecida al diseño.
            -->

            <div
              class="
                aspect-[4/3]
                w-full
                overflow-hidden
                md:aspect-[2.18/1]
              "
            >

              <img
                src={image.src}
                alt={image.alt}
                loading={index <= 2 ? "eager" : "lazy"}
                class="
                  h-full
                  w-full
                  object-cover
                  transition-transform
                  duration-700
                  ease-out
                  group-hover:scale-[1.015]
                "
              />

            </div>

          </button>

        ))
      }

    </div>

  </div>


  <!-- ==========================================================
       DOTS / INDICADORES
       ========================================================== -->

  <div
    class="
      mt-8
      flex
      items-center
      justify-center
      gap-2
      md:mt-9
    "
    aria-label="Seleccionar imagen"
  >

    {
      carrousel.map((_, index) => (

        <button
          type="button"
          data-carousel-dot
          data-index={index}
          aria-label={`Ir a imagen ${index + 1}`}
          class="
            h-[17px]
            w-[17px]
            rounded-full
            border
            border-[#9699a0]
            bg-transparent
            transition-all
            duration-300

            hover:bg-[#9699a0]/40
          "
        >
        </button>

      ))
    }

  </div>

</section>


<script>
  /*
  |--------------------------------------------------------------------------
  | CAROUSEL
  |--------------------------------------------------------------------------
  |
  | No usamos React.
  | No usamos Swiper.
  | No usamos una librería.
  |
  | Astro entrega el HTML y este script controla únicamente
  | el desplazamiento del carousel.
  |
  */

  document
    .querySelectorAll("[data-entorno-carousel]")
    .forEach((carousel) => {

      const viewport =
        carousel.querySelector("[data-carousel-viewport]");

      const track =
        carousel.querySelector("[data-carousel-track]");

      const slides = [
        ...carousel.querySelectorAll("[data-slide]")
      ];

      const dots = [
        ...carousel.querySelectorAll("[data-carousel-dot]")
      ];


      /*
      |--------------------------------------------------------------------------
      | CANTIDAD REAL DE IMÁGENES
      |--------------------------------------------------------------------------
      */

      const count =
        Number(carousel.dataset.count);


      if (!viewport || !track || !slides.length || !count) {
        return;
      }


      /*
      |--------------------------------------------------------------------------
      | ÍNDICE INICIAL
      |--------------------------------------------------------------------------
      |
      | 0 = clon de la última imagen
      | 1 = primera imagen REAL
      |
      */

      let currentIndex =
        count > 1 ? 1 : 0;


      /*
      |--------------------------------------------------------------------------
      | OBTENER ÍNDICE REAL
      |--------------------------------------------------------------------------
      |
      | Convierte el índice visual:
      |
      | 1, 2, 3...
      |
      | a:
      |
      | 0, 1, 2...
      |
      | que es el índice usado por los dots.
      |
      */

      function getRealIndex() {

        if (count === 1) {
          return 0;
        }

        return (
          currentIndex - 1 + count
        ) % count;
      }


      /*
      |--------------------------------------------------------------------------
      | ACTUALIZAR DOTS
      |--------------------------------------------------------------------------
      */

      /*
|--------------------------------------------------------------------------
| ACTUALIZAR TAMAÑO DE SLIDES
|--------------------------------------------------------------------------
|
| La imagen activa crece.
| Las imágenes laterales quedan ligeramente más pequeñas.
|
*/

function updateSlides() {

  slides.forEach((slide, index) => {

    const active =
      index === currentIndex;


    // Imagen activa
    slide.classList.toggle(
      "scale-[1.1]",
      active
    );

    slide.classList.toggle(
      "opacity-100",
      active
    );


    // Imágenes laterales
    slide.classList.toggle(
      "scale-[0.86]",
      !active
    );

    slide.classList.toggle(
      "opacity-80",
      !active
    );


    // La imagen activa queda encima
    slide.classList.toggle(
      "z-10",
      active
    );

  });

}

      function updateDots() {

        const realIndex =
          getRealIndex();

        dots.forEach((dot, index) => {

          const active =
            index === realIndex;

          dot.classList.toggle(
            "bg-[#9699a0]",
            active
          );

          dot.classList.toggle(
            "bg-transparent",
            !active
          );

          dot.setAttribute(
            "aria-current",
            active ? "true" : "false"
          );

        });

      }


      /*
      |--------------------------------------------------------------------------
      | POSICIONAR CAROUSEL
      |--------------------------------------------------------------------------
      |
      | Calculamos:
      |
      | centro de la pantalla
      |        -
      | centro de la imagen
      |
      | y movemos todo el track.
      |
      | Esto permite que la imagen activa siempre quede perfectamente
      | centrada aunque cambie el tamaño de la pantalla.
      |
      */

      function positionCarousel(
        animate = true
      ) {

        const activeSlide =
          slides[currentIndex];

        if (!activeSlide) {
          return;
        }


        if (animate) {

          track.style.transition =
            "transform 700ms cubic-bezier(0.22, 1, 0.36, 1)";

        } else {

          track.style.transition =
            "none";

        }


        const viewportCenter =
          viewport.clientWidth / 2;


        const slideCenter =
          activeSlide.offsetLeft +
          activeSlide.offsetWidth / 2;


        const translateX =
          viewportCenter - slideCenter;


        track.style.transform =
          `translate3d(${translateX}px, 0, 0)`;

        updateSlides();
        updateDots();

      }


      /*
      |--------------------------------------------------------------------------
      | SIGUIENTE
      |--------------------------------------------------------------------------
      */

      function next() {

        if (count <= 1) return;

        currentIndex++;

        positionCarousel(true);

      }


      /*
      |--------------------------------------------------------------------------
      | ANTERIOR
      |--------------------------------------------------------------------------
      */

      function previous() {

        if (count <= 1) return;

        currentIndex--;

        positionCarousel(true);

      }


      /*
      |--------------------------------------------------------------------------
      | CLIC SOBRE LAS IMÁGENES LATERALES
      |--------------------------------------------------------------------------
      |
      | Click izquierda  -> anterior
      | Click derecha    -> siguiente
      |
      */

      slides.forEach((slide, index) => {

        slide.addEventListener(
          "click",
          () => {

            if (index < currentIndex) {
              previous();
            }

            if (index > currentIndex) {
              next();
            }

          }
        );

      });


      /*
      |--------------------------------------------------------------------------
      | DOTS
      |--------------------------------------------------------------------------
      */

      dots.forEach((dot, index) => {

        dot.addEventListener(
          "click",
          () => {

            /*
              +1 porque el slide 0
              es nuestro clon.
            */

            currentIndex =
              count > 1
                ? index + 1
                : 0;

            positionCarousel(true);

          }
        );

      });


      /*
      |--------------------------------------------------------------------------
      | LOOP INFINITO
      |--------------------------------------------------------------------------
      |
      | Cuando llegamos a un clon:
      |
      | esperamos que termine la animación
      |
      | y saltamos silenciosamente a su equivalente real.
      |
      */

      track.addEventListener(
        "transitionend",
        (event) => {

          if (
            event.propertyName !== "transform"
          ) {
            return;
          }


          /*
          |--------------------------------------------------------------
          | CLON DEL FINAL
          |--------------------------------------------------------------
          */

          if (
            currentIndex === count + 1
          ) {

            currentIndex = 1;

            positionCarousel(false);

          }


          /*
          |--------------------------------------------------------------
          | CLON DEL PRINCIPIO
          |--------------------------------------------------------------
          */

          if (
            currentIndex === 0
          ) {

            currentIndex = count;

            positionCarousel(false);

          }

        }
      );


      /*
      |--------------------------------------------------------------------------
      | TECLADO
      |--------------------------------------------------------------------------
      */

      carousel.addEventListener(
        "keydown",
        (event) => {

          if (event.key === "ArrowRight") {
            next();
          }

          if (event.key === "ArrowLeft") {
            previous();
          }

        }
      );


      /*
      |--------------------------------------------------------------------------
      | RESPONSIVE
      |--------------------------------------------------------------------------
      |
      | Como el ancho de las imágenes es responsive,
      | debemos recalcular cuando cambia la ventana.
      |
      */

      let resizeTimer;

      window.addEventListener(
        "resize",
        () => {

          clearTimeout(resizeTimer);

          resizeTimer =
            setTimeout(
              () => {
                positionCarousel(false);
              },
              100
            );

        }
      );


      /*
      |--------------------------------------------------------------------------
      | POSICIÓN INICIAL
      |--------------------------------------------------------------------------
      */

      positionCarousel(false);

    });
</script>