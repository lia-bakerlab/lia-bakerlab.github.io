---
import Layout from '../layouts/Layout.astro';

const seo = {
  title:
    'La Castellana | Departamentos de 1 y 2 Dormitorios en Las Condes | Golf Oriente',

  description:
    'La Castellana de Golf Oriente. Departamentos de 1 y 2 dormitorios en La Castellana Sur con Apoquindo, Las Condes. Vive en un barrio consolidado, conectado y estratégicamente ubicado.',

  image:
    '/images/la-castellana/og-la-castellana.jpg',
};
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image}
>

  <!-- ======================================
       HEADER
  ======================================= -->

  <header class="site-header">

    <div class="container header-inner">

      <a
        href="#inicio"
        class="logo"
        aria-label="La Castellana - Inicio"
      >
        Logo Golfo Oriente
      </a>

      <nav
        class="navigation"
        aria-label="Navegación principal"
      >
        <a href="#proyecto">
          Proyecto
        </a>

        <a href="#departamentos">
          Departamentos
        </a>

        <a href="#ubicacion">
          Ubicación
        </a>

        <a href="#entorno">
          Entorno
        </a>

        <a href="#contacto">
          Contacto
        </a>
      </nav>

      <a
        class="header-cta"
        href="#contacto"
      >
        Cotiza aquí
      </a>

    </div>

  </header>


  <main>

    <!-- ======================================
         HERO
    ======================================= -->

    <section
      id="inicio"
      class="hero"
    >

      <div class="container">

        <div class="hero-content">

          <span class="eyebrow">
            Subtitle
          </span>

          <h1>
			Project Title
		</h1>

          <p class="hero-claim">
            Project Quote.
          </p>

          <p class="hero-description">
            Departamentos de 1 y 2 dormitorios
            en La Castellana Sur con Apoquindo.
            Vive en un barrio consolidado,
            estratégicamente conectado con Las Condes.
          </p>

          <div class="hero-actions">

            <a
              href="#proyecto"
              class="button button-primary"
            >
              Conoce el proyecto
            </a>

            <a
              href="#contacto"
              class="button button-secondary"
            >
              Cotiza tu departamento
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ======================================
         PROYECTO
    ======================================= -->

    <section
      id="proyecto"
      class="section"
    >

      <div class="container project-grid">

        <div class="project-copy">

          <span class="eyebrow">
            El proyecto
          </span>

          <h2>
            Tu espacio,
            en el lugar correcto.
          </h2>

          <p>
            La Castellana es un proyecto residencial
            de Golf Oriente pensado para quienes
            valoran vivir conectados a la ciudad
            sin renunciar a la tranquilidad de
            un barrio consolidado.
          </p>

          <p>
            Departamentos de 1 y 2 dormitorios
            se integran a una ubicación privilegiada
            en el sector de La Castellana Sur
            con Apoquindo, uno de los puntos
            estratégicos de Las Condes.
          </p>

        </div>

        <img
          class="project-image"
          src={`${import.meta.env.BASE_URL}images/la-castellana/proyecto-exterior-01.jpg`}
          alt="Exterior proyecto La Castellana de Golf Oriente en Las Condes"
          width="1200"
          height="1500"
          loading="lazy"
        />

      </div>

    </section>


   

    <!-- ======================================
         UBICACIÓN
    ======================================= -->

    <section
      id="ubicacion"
      class="section"
    >

      <div class="container location-grid">

        <div class="location-copy">

          <span class="eyebrow">
            Ubicación
          </span>

          <h2>
            Ubicación lo es todo.
          </h2>

          <p>
            Vivir en La Castellana significa estar
            cerca de todo lo que necesitas.
            Su ubicación en La Castellana Sur
            con Apoquindo permite disfrutar
            de la conectividad, servicios y vida
            urbana de Las Condes desde un
            entorno residencial consolidado.
          </p>

          <ul class="location-list">

            <li>
              La Castellana Sur
            </li>

            <li>
              Apoquindo
            </li>

            <li>
              Las Condes
            </li>

            <li>
              Barrio consolidado
            </li>

            <li>
              Ubicación estratégica
            </li>

            <li>
              Comercio y servicios
            </li>

          </ul>

        </div>

         <img
          class="location-image"
          src={`${import.meta.env.BASE_URL}images/la-castellana/proyecto-exterior-01.jpg`}
          alt="Sector La Castellana Sur con Apoquindo en Las Condes"
          width="1200"
          height="1400"
          loading="lazy"
        />


      </div>

    </section>


    <!-- ======================================
         ENTORNO
    ======================================= -->

    <section
      id="entorno"
      class="section neighborhood"
    >

      <div class="container">

        <div class="section-intro">

          <span class="eyebrow">
            El entorno
          </span>

          <h2>
            Un barrio consolidado.
            Una ubicación estratégica.
          </h2>

          <p>
            La Castellana se inserta en un sector
            reconocido de Las Condes, con acceso
            a importantes ejes de transporte,
            comercio, servicios y equipamiento urbano.
            Una ubicación pensada para aprovechar
            mejor la ciudad y hacer más simple cada día.
          </p>

        </div>

      </div>

    </section>


    <!-- ======================================
         CONTACTO
    ======================================= -->

    <section
      id="contacto"
      class="section contact"
    >

      <div class="container">

        <span class="eyebrow">
          Golf Oriente
        </span>

        <h2>
          Vive La Castellana.
        </h2>

        <p>
          Déjanos tus datos y recibe más información
          sobre departamentos de 1 y 2 dormitorios,
          disponibilidad y características del proyecto.
        </p>

        <!--
          REEMPLAZAR MÁS ADELANTE
          por el formulario definitivo.
        -->

        <a
          href="mailto:ventas@golforiente.cl"
          class="button button-secondary"
        >
          Solicitar información
        </a>

      </div>

    </section>

  </main>


  <!-- ======================================
       FOOTER
  ======================================= -->

  <footer class="footer">

    <div class="container footer-inner">

      <div class="footer-logo">
        La Castellana
      </div>

      <div>
        Proyecto inmobiliario Golf Oriente · Las Condes
      </div>

    </div>

  </footer>

</Layout>