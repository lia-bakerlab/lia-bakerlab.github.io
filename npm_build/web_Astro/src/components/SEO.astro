---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = 'La Castellana | Departamentos de 1 y 2 Dormitorios en Las Condes | Golf Oriente',
  description = 'La Castellana de Golf Oriente. Departamentos de 1 y 2 dormitorios en La Castellana Sur con Apoquindo, Las Condes. Vive en un barrio consolidado, conectado y estratégicamente ubicado.',
  image = '/images/la-castellana/og-la-castellana.jpg',
  canonical,
  noindex = false,
} = Astro.props;

const siteName = 'La Castellana | Golf Oriente';

const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);

const imageURL = new URL(image, Astro.site);

const keywords = [
  'La Castellana',
  'Golf Oriente',
  'departamentos La Castellana',
  'departamentos Las Condes',
  'departamentos Apoquindo',
  'departamentos La Castellana Sur',
  'departamentos 1 dormitorio Las Condes',
  'departamentos 2 dormitorios Las Condes',
  'departamentos nuevos Las Condes',
  'proyecto inmobiliario Las Condes',
  'proyecto La Castellana',
  'inmobiliaria Golf Oriente',
  'departamentos cerca de Apoquindo',
  'departamentos sector Apoquindo',
  'departamentos barrio La Castellana',
  'comprar departamento Las Condes',
  'departamento para inversión Las Condes',
  'departamentos ubicación estratégica',
].join(', ');
---

<title>{title}</title>

<meta
  name="description"
  content={description}
/>

<meta
  name="keywords"
  content={keywords}
/>

<meta name="author" content="Golf Oriente" />

<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow'}
/>

<link
  rel="canonical"
  href={canonicalURL}
/>

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_CL" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
<meta
  property="og:image:alt"
  content="La Castellana, proyecto inmobiliario de Golf Oriente en Las Condes"
/>

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />